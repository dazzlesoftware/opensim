      "localPatches": [
        {
          "path": "httplib/opensim-raw-requests.patch",
          "sha256": "361f33ad5fa26fa12f0d22e577ae455a3e5223ba16d82bf99eca3c4089e876bc",
          "scope": "Adds default-on request decompression toggle; scene protocol hosts can retain raw gzip bytes for source handler decoding. Existing default behavior is unchanged."
        },
        {
          "path": "httplib/opensim-async-response.patch",
          "sha256": "bb2ccc593b1a8825f20335a50008e6c22dffd4c6f6463ba9173398dfaf5da747",
          "scope": "Opt-in native response deferral hook after complete body parsing, weak per-request transport context and protected response serializer. Existing synchronous behavior remains the default; native host owns socket/stream lifetime."
        },
        {
          "path": "httplib/opensim-deferred-ranges.patch",
          "sha256": "8f75be27cabd7a1c6710b93f78504ffadbdfa19b1b2fd403c8142790ae992990",
          "scope": "Opt-in deferred hosts retain raw Range headers for original OpenSim handler parsing. Synchronous cpp-httplib range validation remains unchanged."
        },
        {
          "path": "httplib/opensim-response-headers.patch",
          "sha256": "a6947c704b3d2ff718c02637a91ddc1e696022e81bcef96bc50ff50e6c96d4e2",
          "scope": "Opt-in client response-header policy before framing/body reads. The requester can project source first Content-Length behavior and abandon bodies at headers; default client/server validation is unchanged. Opt-in request-header suppression prevents automatic Accept/Accept-Encoding/User-Agent injection for original requester semantics; defaults remain unchanged. Opt-in source redirects strip Authorization at every hop and convert POST on300/301/302, retaining remaining request headers and dropping content headers on GET. Source mode follows only300/301/302/303/307/308 with Location; default redirect status behavior remains unchanged."
        },
        {
          "path": "httplib/opensim-config-http.patch",
          "sha256": "133ce973d91f425b7b8ab1c446589d11e06364aba23051bb7b8bdcc3c127fb97",
          "scope": "Opt-in raw XML configuration HTTP head/entity framing, per-request header deadlines and per-stream native connection/DNS/read/write error diagnostics. Adds a Request streaming overload; default client/server framing and policies remain unchanged."
        }
      ]
    },
