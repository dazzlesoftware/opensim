; Experimental connected native region. Full simulator parity remains unfinished.
; Copy beside the account databases as native-region.ini.
[NativeServer]
ListenAddress = 127.0.0.1
EnableLocalRegion = true
EnableRegionAssets = true
; Asset-enabled regions default to 16 MiB; upload handlers enforce their own limits.
; MaximumRequestBytes = 16777216
UserAccountDatabase = users.db
AuthenticationDatabase = users.db
InventoryDatabase = inventory.db
GridUserDatabase = gridusers.db
EnableAvatarService = true
AvatarDatabase = avatars.db
HttpTimeoutSeconds = 15

[Network]
http_listener_port = 9000

[NativeRegion]
ID = 11111111-1111-4111-8111-111111111111
Name = Native Region
LocationX = 1000
SizeX = 256
SizeY = 256
LocationY = 1000
UDPPort = 9000
BindAddress = 127.0.0.1
ExternalHost = 127.0.0.1
OwnerID = 00000000-0000-0000-0000-000000000000
; Optional existing SQLite EstateStore. Relative paths resolve beside this INI.
; EstateDatabase = estate.db

; For estate admission from existing SQLite Groups V2 membership rows,
; configure these settings in a separate section.
; [Groups]
; Enabled = true
; ServicesConnectorModule = Groups Local Service Connector
; SQLiteMembershipDatabase = groups.db
; Optional authoritative single-avatar terrain physics using original native ubODE.
Physics = ubODE
; PhysicsLibrary = ../bin/lib64/ubode.dll
; Omit PhysicsLibrary to discover the bundled library for this platform.
; Default Physics=None supports protocol/object/script probes without movement.
; Optional custom default script text; requires EnableRegionAssets.
; Each new script stores its actual text under a new asset UUID.
; DefaultScriptFile = ../bin/assets/ScriptsAssetSet/DefaultSayAndTouch.lsl

[GridService]
DefaultRegionFlags = +DefaultRegion +FallbackRegion

[LoginService]
RequireInventory = true
WelcomeMessage = Experimental native OpenSim region

; Relative asset database paths resolve from the process working directory.
[Modules]
; Select the original local profile connector; the service below is disabled by default.
UserProfilesServices = LocalUserProfilesServicesConnector
AssetServices = LocalAssetServicesConnector
; For a grid region that obtains sessions from Robust:
; PresenceServices = RemotePresenceServicesConnector
; GridUserServices = RemoteGridUserServicesConnector

; [PresenceService]
; PresenceServerURI = http://127.0.0.1:8003
; AuthType = BasicHttpAuthentication
; HttpAuthUsername = service
; HttpAuthPassword = configure-a-password

; [GridUserService]
; GridUserServerURI = http://127.0.0.1:8003
; AuthType = BasicHttpAuthentication
; HttpAuthUsername = service
; HttpAuthPassword = configure-a-password

[AssetService]
LocalServiceModule = OpenSim.Services.AssetService.dll:AssetService
StorageProvider = OpenSim.Data.SQLite.dll
ConnectionString = URI=file:assets.db;version=3;Pooling=false
DefaultAssetLoader = OpenSim.Framework.AssetLoader.Filesystem.dll
AssetLoaderArgs = assets/AssetSets.xml

[ClientStack.LindenCaps]
Cap_GetTexture = localhost
Cap_GetMesh = localhost
Cap_GetMesh2 = localhost
Cap_GetAsset = localhost
Cap_FetchInventory2 = localhost
Cap_FetchInventoryDescendents2 = localhost
Cap_FetchLib2 = localhost
Cap_FetchLibDescendents2 = localhost

[LibraryService]
; Omit DefaultLibrary to load the bundled inventory library.
LibraryName = OpenSim Library

; Optional original memory-only Flotsam cache and baked uploads:
; Add AssetCaching=FlotsamAssetCache to the existing [Modules] section.
; Add Cap_UploadBakedTexture=localhost to [ClientStack.LindenCaps].
; Then add this section (file-backed Flotsam caching remains unimplemented):
; [AssetCache]
; FileCacheEnabled=false
; MemoryCacheEnabled=true
; MemoryCacheTimeout=0.25

; Optional profile service on this region's HTTP listener.
[UserProfilesService]
Enabled = false
LocalServiceModule = "OpenSim.Services.UserProfilesService.dll:UserProfilesService"
StorageProvider = "OpenSim.Data.SQLite.dll"
; Relative SQLite paths follow the process working directory.
ConnectionString = "Data Source=profiles.db"
UserAccountService = "OpenSim.Services.UserAccountService.dll:UserAccountService"
