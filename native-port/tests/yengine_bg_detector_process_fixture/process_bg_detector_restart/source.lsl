    }
    touch_start(integer n)
    {
background++;
before=xmrEventSaveDets();
xmrEventLoadDets([1,"11111111-2222-3333-4444-555555555555",<100.123456789,101.234567891,102.345678912>,7,"22222222-3333-4444-5555-666666666666","replacement detector","33333333-4444-5555-6666-777777777777",<110.123456789,111.234567891,112.345678912>,<.625,.5,.375,.25>,11,<120.123456789,121.234567891,122.345678912>,<130.123456789,131.234567891,132.345678912>,<133.123456789,134.234567891,135.345678912>,<136.123456789,137.234567891,138.345678912>,<139.123456789,140.234567891,141.345678912>,<142.123456789,143.234567891,144.345678912>,13]);
replacement=xmrEventSaveDets();
