integer resumed;
integer complete;
default
{
    state_entry()
    {
entries++;
xmrEventLoadDets([1,"11111111-2222-3333-4444-555555555555",<0.123456789,1.234567891,2.345678912>,7,"22222222-3333-4444-5555-666666666666","selected binary detector","33333333-4444-5555-6666-777777777777",<10.123456789,11.234567891,12.345678912>,(rotation)"<0,0,0,0>",11,<20.123456789,21.234567891,22.345678912>,<30.123456789,31.234567891,32.345678912>,<33.123456789,34.234567891,35.345678912>,<36.123456789,37.234567891,38.345678912>,<39.123456789,40.234567891,41.345678912>,<42.123456789,43.234567891,44.345678912>,13]);
