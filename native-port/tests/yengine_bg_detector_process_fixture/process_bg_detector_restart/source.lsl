xmrEventLoadDets([1,"11111111-2222-3333-4444-555555555555",<300.123456789,301.234567891,302.345678912>,7,"22222222-3333-4444-5555-666666666666","queued XML detector","33333333-4444-5555-6666-777777777777",<310.123456789,311.234567891,312.345678912>,<.123456789,-.987654321,.333333333,-.00000049>,11,<320.123456789,321.234567891,322.345678912>,<330.123456789,331.234567891,332.345678912>,<333.123456789,334.234567891,335.345678912>,<336.123456789,337.234567891,338.345678912>,<339.123456789,340.234567891,341.345678912>,<342.123456789,343.234567891,344.345678912>,13]);
