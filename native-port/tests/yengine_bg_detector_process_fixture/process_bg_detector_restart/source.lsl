xmrEventLoadDets([1,"11111111-2222-3333-4444-555555555555",<200.123456789,201.234567891,202.345678912>,7,"22222222-3333-4444-5555-666666666666","root XML detector","33333333-4444-5555-6666-777777777777",<210.123456789,211.234567891,212.345678912>,(rotation)"<0,0,0,0>",11,<220.123456789,221.234567891,222.345678912>,<230.123456789,231.234567891,232.345678912>,<233.123456789,234.234567891,235.345678912>,<236.123456789,237.234567891,238.345678912>,<239.123456789,240.234567891,241.345678912>,<242.123456789,243.234567891,244.345678912>,13]);
