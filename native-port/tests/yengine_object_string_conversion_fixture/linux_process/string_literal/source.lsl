YOption arrays;YOption chars;string input="same";string first;string second;string again;object a;object b;object c;integer repeated;integer literal_match;integer text_match;integer after_pair;integer generated_match;integer after;default{state_entry(){first=(string)input;second=(string)input;a=first;b=second;repeated=(a==b);literal_match=(a==(object)"same");text_match=(first=="same");again=(string)input;c=again;after_pair=(a==b);generated_match=(a==c);after=1;}}