YOption allowall;
integer[] input; integer[] other; object first; object second; object third; object literal; integer pre_same; integer pre_cross; integer pre_literal; integer post_first; integer post_second; integer post_cross; integer post_literal; integer hash_first; integer hash_second; integer hash_fresh; integer after;
default{state_entry(){input=new integer[](1);other=new integer[](2);first=xmrTypeName((object)input);second=xmrTypeName((object)input);third=xmrTypeName((object)other);literal="integer[]";pre_same=(first==second);pre_cross=(first==third);pre_literal=(first==literal);hash_first=xmrHashCode(first);hash_second=xmrHashCode(second);llSleep(0.1);post_first=(first==(object)xmrTypeName((object)input));post_second=(second==(object)xmrTypeName((object)input));post_cross=(third==(object)xmrTypeName((object)other));post_literal=(literal==(object)xmrTypeName((object)input));hash_fresh=xmrHashCode((object)xmrTypeName((object)input));after=1;}}
