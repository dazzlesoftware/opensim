integer aliasLeft;integer intrinsicLeft;integer aliasUsed;integer intrinsicUsed;integer sum;integer ok;probe(string text,list data){aliasLeft=xmrHeapLeft();intrinsicLeft=llGetFreeMemory();aliasUsed=xmrHeapUsed();intrinsicUsed=llGetUsedMemory();sum=aliasLeft+aliasUsed;ok=(aliasLeft==intrinsicLeft)&&(aliasUsed==intrinsicUsed);}outer(){string text="abcdef";list data=[1,text,"ghi"];probe(text,data);}default{state_entry(){outer();}}