integer alive;integer aliasLeft;integer intrinsicLeft;integer aliasUsed;integer intrinsicUsed;integer sum;integer ok;integer beforeOK;integer beforeSum;list result;default{state_entry(){xmrEventEnqueue([21,7]);xmrEventEnqueue([29,9]);result=xmrEventDequeue(600.0,536870912,0,2097152,0);}touch_start(integer n){string text="abcdef";list data=[n,text,"ghi"];aliasLeft=xmrHeapLeft();intrinsicLeft=llGetFreeMemory();aliasUsed=xmrHeapUsed();intrinsicUsed=llGetUsedMemory();sum=aliasLeft+aliasUsed;ok=(aliasLeft==intrinsicLeft)&&(aliasUsed==intrinsicUsed);beforeOK=ok;beforeSum=sum;llSleep(1.0);alive=llStringLength(text)+llGetListLength(data);aliasLeft=xmrHeapLeft();intrinsicLeft=llGetFreeMemory();aliasUsed=xmrHeapUsed();intrinsicUsed=llGetUsedMemory();sum=aliasLeft+aliasUsed;ok=(aliasLeft==intrinsicLeft)&&(aliasUsed==intrinsicUsed);}touch_end(integer n){}}